generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  passwordHash       String
  avatar             String?
  language           String             @default("English")
  unit               String             @default("metric")
  currency           String             @default("USD")
  defaultVisibility  String             @default("private")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  trips              Trip[]
  savedDestinations  SavedDestination[]
}

model Trip {
  id          String      @id @default(uuid())
  userId      String
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  coverCityId String?
  isPublic    Boolean     @default(false)
  shareToken  String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]
  budget      Budget?

  @@index([userId])
}

model TripStop {
  id           String     @id @default(uuid())
  tripId       String
  cityId       String?
  cityName     String
  country      String?
  arrivalDate  DateTime
  departureDate DateTime
  orderIndex   Int
  trip         Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities   Activity[]

  @@unique([tripId, orderIndex])
  @@index([tripId])
}

model Activity {
  id          String   @id @default(uuid())
  stopId      String
  title       String
  category    String?
  description String?
  duration    Int?
  cost        Float    @default(0)
  startTime   String?
  notes       String?
  stop        TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@index([stopId])
}

model Budget {
  id               String @id @default(uuid())
  tripId           String @unique
  transportCost    Float  @default(0)
  stayCost         Float  @default(0)
  mealCost         Float  @default(0)
  activityCost     Float  @default(0)
  miscellaneousCost Float @default(0)
  totalCost        Float  @default(0)
  trip             Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model SavedDestination {
  id        String   @id @default(uuid())
  userId    String
  city      String
  country   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, country])
}
